#!/usr/bin/env bash
# cgc — human-facing CLI for open-claude-gpt.
# Thin dispatcher over the skill scripts so you can drive a consult by hand
# (Claude Code invokes the same scripts automatically via the skill).
#
#   cgc doctor  [--deep] [--json]     health check / preflight
#   cgc launch  [--gate]              start the dedicated debug Chrome, probe login
#   cgc install-daemon                install the egress daemon as a launchd agent — RUN THIS ONCE.
#                                     Starts at login, restarts if it dies, so neither you nor the
#                                     agent ever has to start or check it again.
#   cgc uninstall-daemon              stop that launchd agent (waits until it has really exited), then
#                                     remove its plist; keeps the plist if the daemon will not stop
#   cgc daemon-stop                   stop the launchd daemon and wait for it to exit. Exit 0 = stopped,
#                                     10 = it was not loaded (nothing done), 1 = still loaded after the
#                                     wait. install.sh calls this BEFORE it replaces any code.
#   cgc daemon-start                  load the installed plist, then wait for the daemon's heartbeat and
#                                     check it runs THIS code's schema (exit 1 on timeout/mismatch,
#                                     10 = no plist installed)
#   cgc daemon-pid                    print the pid of the daemon whose heartbeat is live (exit 1: none),
#                                     however it was started (launchd, `cgc watch`, `cgc up`)
#   cgc watch   [--once]              run the egress daemon in the FOREGROUND (debugging / one-off)
#   cgc up                            start the debug Chrome AND the daemon (detached) — ad-hoc setup
#   cgc fire    <args…>               deliver+prep+enqueue in ONE call — the normal path
#   cgc deliver <args…>               resolve GitHub links only            (consult.py deliver)
#   cgc prep    <args…>               render the consult prompt            (consult.py prep)
#   cgc enqueue <args…>               queue a job for the daemon (LOCAL write) (cgc_spool.py enqueue)
#   cgc await   <args…>               poll the local answer file for a queued job (cgc_spool.py await)
#   cgc cancel  --rid R               cancel a round BEFORE it sends (queued/ready only; idempotent)
#   cgc queue   [--rid R]             show daemon liveness + spool contents (cgc_spool.py status)
#   cgc probe   [--only C|--status]   no-send check of the ChatGPT UI contract; prints capability states
#   cgc stats   [--week]              reliability metrics; --week = rolling-7-day budget/grading view
#   cgc feedback --rid R --grade G --reason W --action A [--evidence E]
#                                     grade a consult's answer (LOCAL); `feedback --policy "…"` records
#                                     the weekly review. Grade 1/2 require --evidence.
#   cgc submit / followup             RETIRED — the store daemon's send_round is the sole send path
#                                     (use `cgc fire` / `prep --followup` + `enqueue --kind followup`)
#   cgc wait    <args…>               read-only DIRECT poll (no send)      (cdp_consult.py wait)
#   cgc status  <args…>               read-only one-shot progress JSON     (cdp_consult.py status)
#
# AUTO-MODE PATH (default under Claude Code's data-exfiltration classifier):
#   fire → await. The agent only touches LOCAL files (fire makes no network call either);
#   the user's launchd daemon performs the external send after re-validating the code is public.
#   DIRECT PATH (submit/wait) talks to chatgpt.com from the agent's own Bash call, which the
#   auto-mode classifier hard-denies — use it only in interactive mode or when driving by hand.
#   cgc set-project <url>|--clear     persist which ChatGPT project consults open (all users)
#   cgc get-project                   print the stored project URL
#   cgc config                        print the effective configuration
#   cgc activation-hook               print an OPTIONAL SessionStart hook snippet
#                                     (proactive offloading) — default is print-only, never edits
#   cgc activation-hook --install     add/upgrade that hook in your Claude settings.json
#                                     (backs up settings.json first)
#   cgc activation-hook --remove      remove it again
#   cgc activation-hook --status      report configured / broken / absent / unreadable
#                                     (all four forward extra args, e.g. --settings, --json)
#
# Port: submit/followup/wait/status forward args as-is to cdp_consult.py, which
# requires --port BEFORE the subcommand. Prefer the CGC_PORT env var instead,
# e.g. `CGC_PORT=9334 cgc wait ...` — it works regardless of arg order.
#
# Resolves the skill scripts from (in order): $CGC_HOME, the installed skill,
# or this repo's ./skill — so it works installed OR straight from a clone.
set -euo pipefail

find_scripts() {
  local c candidates=()
  [ -n "${CGC_HOME:-}" ] && candidates+=("$CGC_HOME/scripts")
  candidates+=(
    "$HOME/.claude/skills/chatgpt-consult/scripts"
    "$(cd "$(dirname "$0")/.." && pwd)/skill/scripts"
  )
  for c in "${candidates[@]}"; do
    [ -f "$c/consult.py" ] && { printf '%s' "$c"; return; }
  done
}
S="$(find_scripts)"
[ -z "$S" ] && { echo "cgc: cannot locate skill scripts (set CGC_HOME)" >&2; exit 1; }

LABEL="com.open-claude-gpt.daemon"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
GUI="gui/$(id -u)"

# "Is there a launchd to manage" is asked of PATH, not of uname: the same answer on a Mac, and a
# launchctl stub on PATH is all a test needs.
have_launchd() { command -v launchctl >/dev/null 2>&1; }
loaded() { launchctl print "$GUI/$LABEL" >/dev/null 2>&1; }

# A zombie answers kill -0 forever; only a process that has really gone counts as stopped.
alive() { kill -0 "$1" 2>/dev/null && [ "$(ps -o stat= -p "$1" 2>/dev/null | cut -c1)" != Z ]; }

# Stop the launchd job and wait until its process has really exited. bootout can return while the
# daemon is still draining; replacing or deleting its code before that is the failure this exists to
# prevent. The process is the one the heartbeat names, read BEFORE the stop. The fallback has no -w:
# that would mark the label disabled across logins.
stop_job() {
  local i n pid="" limit="${CGC_STOP_WAIT_S:-60}"
  loaded || return 0
  pid="$(heartbeat 2>/dev/null)" || pid=""
  launchctl bootout "$GUI/$LABEL" 2>/dev/null || launchctl unload "$PLIST" 2>/dev/null || true
  n=$((limit * 2))
  for ((i = 0; i < n; i++)); do
    if ! loaded && { [ -z "$pid" ] || ! alive "$pid"; }; then return 0; fi
    sleep 0.5
  done
  echo "cgc: the daemon is still running ${limit}s after the stop request — not touching its files." >&2
  return 1
}

# Heartbeat of the live daemon: prints its pid, exit 1 when none is live. With --current it also exits
# 3 (reason on stderr) unless the daemon serves THIS install's store and schema, the same test the
# doctor applies: an old-code daemon that survived, or one the new code cannot talk to.
heartbeat() {
  python3 - "$S" "${1:-}" <<'PYEOF'
import sys
sys.path.insert(0, sys.argv[1])
import cgc_spool
d = cgc_spool.daemon_identity()
if d is None:
    sys.exit(1)
print(d.get("pid"))
if sys.argv[2] == "--current":
    import cgc_doctor      # only here: stopping a daemon must not depend on the doctor importing
    bad = cgc_doctor.daemon_mismatch(d)
    if bad:
        sys.stderr.write(f"cgc: the live daemon (pid {d.get('pid')}) {bad}\n")
        sys.exit(3)
PYEOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  doctor)   exec python3 "$S/cgc_doctor.py" "$@" ;;
  launch)   [ "${1:-}" = "--gate" ] && { shift; exec env CGC_GATE=1 bash "$S/cdp_launch.sh" "$@"; }
            exec bash "$S/cdp_launch.sh" "$@" ;;
  watch)    exec python3 "$S/cgc_daemon.py" "$@" ;;
  install-daemon)
    # Make the daemon permanent. Everything else in this tool is designed so a consult "just works";
    # the one remaining human step was starting the daemon, which stalled the agent mid-task and made
    # it burn tokens checking. launchd removes it: RunAtLoad + KeepAlive means the daemon is up at
    # login and respawns if it crashes. The daemon still runs as YOU (your login session, your gate,
    # your ChatGPT profile) — the agent never starts it, it just finds it already there.
    have_launchd || {
      echo "cgc install-daemon: needs launchd (macOS). On Linux, run the equivalent systemd --user" >&2
      echo "  unit for: $(command -v python3) $S/cgc_daemon.py" >&2; exit 2; }
    label="$LABEL"
    plist="$PLIST"
    log="${CGC_STATE_DIR:-/tmp/cgc}/daemon.log"
    mkdir -p "$HOME/Library/LaunchAgents" "$(dirname "$log")"
    # Generate the plist with plistlib rather than hand-rolled XML (escaping is not our problem to
    # get wrong). Bake the CURRENT PATH: a LaunchAgent otherwise gets a minimal one and the gate's
    # `gh` repo-visibility check — the thing that keeps private code from being sent — would fail.
    python3 - "$plist" "$label" "$(command -v python3)" "$S/cgc_daemon.py" "$log" "$PATH" <<'PYEOF'
import os, plistlib, sys
plist_path, label, py, script, log, path = sys.argv[1:7]
env = {"PATH": path}
env.update({k: v for k, v in os.environ.items() if k.startswith("CGC_")})
with open(plist_path, "wb") as f:
    plistlib.dump({
        "Label": label,
        "ProgramArguments": [py, script],
        "RunAtLoad": True,        # up as soon as you log in
        "KeepAlive": True,        # respawn if it ever dies
        "StandardOutPath": log,
        "StandardErrorPath": log,
        "EnvironmentVariables": env,
        # No "ProcessType": "Background". That key tells launchd the job is not involved in user
        # interaction, so it gets throttled scheduling and I/O — but this daemon's entire job is to
        # launch and drive a GUI Chrome in the user's Aqua session. Omitting it leaves the default
        # ("Standard"), which is what a browser-driving agent actually is.
    }, f)
print(f"cgc: wrote {plist_path}")
PYEOF
    stop_job || exit 1
    launchctl bootstrap "$GUI" "$plist" 2>/dev/null || launchctl load -w "$plist"
    sleep 1
    python3 "$S/cgc_spool.py" status
    echo
    echo "The daemon is now permanent — it starts at login and respawns if it dies."
    echo "Remaining one-time step (only if you have not done it): log into ChatGPT Pro in the"
    echo "debug Chrome — run 'cgc launch', log in, done. The daemon opens Chrome itself after that."
    ;;
  uninstall-daemon)
    # Stop first and wait; the plist goes only once the daemon has really exited, so a daemon that will
    # not stop is still addressable (and `cgc uninstall-daemon` can simply be re-run).
    if have_launchd; then
      stop_job || exit 1
      if [ -e "$PLIST" ]; then rm -f "$PLIST"; echo "cgc: stopped the daemon and removed $PLIST."
      else echo "cgc: no daemon service installed ($PLIST absent)."; fi
    else
      echo "cgc: no launchd service on this platform; nothing to remove."
    fi
    ;;
  daemon-stop)
    have_launchd && loaded || exit 10
    stop_job || exit 1
    echo "cgc: daemon stopped."
    ;;
  daemon-start)
    have_launchd && [ -e "$PLIST" ] || exit 10
    loaded || launchctl bootstrap "$GUI" "$PLIST" 2>/dev/null || launchctl load -w "$PLIST"
    n=$((${CGC_START_WAIT_S:-30} * 2)); rc=1
    for ((i = 0; i < n; i++)); do
      rc=0; heartbeat --current >/dev/null 2>&1 || rc=$?
      [ "$rc" = 0 ] && { echo "cgc: daemon is up (heartbeat live, store schema current)."; exit 0; }
      sleep 0.5
    done
    if [ "$rc" = 3 ]; then
      heartbeat --current >/dev/null || true       # prints why the live daemon is not this install's
    else
      echo "cgc: no live daemon heartbeat ${CGC_START_WAIT_S:-30}s after loading $PLIST (log: ${CGC_STATE_DIR:-/tmp/cgc}/daemon.log)." >&2
    fi
    exit 1
    ;;
  daemon-pid)
    heartbeat ;;
  up)
    # Full setup in one command (USER-run, not the agent): ensure the debug Chrome is up, then
    # start the egress daemon DETACHED so it keeps running after this shell exits. The agent must
    # NOT run this — it starts a process that sends to chatgpt.com; it is user-owned setup, like login.
    if CGC_GATE=1 bash "$S/cdp_launch.sh"; then :; fi
    if python3 "$S/cgc_spool.py" status 2>/dev/null | grep -q '^daemon: UP'; then
      echo "cgc up: daemon already running."
    else
      logf="${CGC_STATE_DIR:-/tmp/cgc}/daemon.log"
      mkdir -p "$(dirname "$logf")"
      nohup python3 "$S/cgc_daemon.py" >>"$logf" 2>&1 &
      sleep 1
      echo "cgc up: daemon started (pid $!), logging to $logf"
    fi
    exec python3 "$S/cgc_spool.py" status ;;
  enqueue|await|cancel|stats|feedback) exec python3 "$S/cgc_spool.py" "$cmd" "$@" ;;
  probe)    exec python3 "$S/cgc_probe.py" "$@" ;;
  queue)    exec python3 "$S/cgc_spool.py" status "$@" ;;
  deliver)  # human-driven: allowed to verify provenance over the network up front. The AGENT
            # path calls consult.py directly and stays offline (see consult.py _GH_ALLOWED).
            exec python3 "$S/consult.py" deliver --verify "$@" ;;
  prep)     exec python3 "$S/consult.py" prep "$@" ;;
  fire)     exec python3 "$S/consult.py" fire "$@" ;;
  submit|followup)
            # Direct send is retired: the daemon's send_round is the SOLE egress path, so the gate
            # can never be bypassed by which verb sent. Use fire (submit) / prep --followup + enqueue.
            echo "cgc $cmd: direct send is retired — the store-backed daemon is the only send path." >&2
            echo "  new consult:  cgc fire ...        follow-up:  cgc prep --followup ... && cgc enqueue --kind followup --conversation <id> ..." >&2
            exit 2 ;;
  wait|status)
            # Read-only diagnostics only (no send). cdp_consult.py takes --port BEFORE the subcommand.
            exec python3 "$S/cdp_consult.py" "$cmd" "$@" ;;
  set-project)
    # Persist which ChatGPT project a fresh consult opens, for ALL future consults, in the
    # tool's own config file (~/.config/cgc/config) — no shell rc or settings.json edit needed.
    # A real CGC_PROJECT_URL env var still overrides it. Pass a project URL, or --clear to unset.
    url="${1:-}"
    case "$url" in
      "") echo "usage: cgc set-project <chatgpt-project-url>   e.g. https://chatgpt.com/g/g-p-<id>-<slug>/project" >&2
          echo "       cgc set-project --clear   (open a plain new chat again)" >&2; exit 2 ;;
      --clear) exec python3 "$S/cgc_config.py" set CGC_PROJECT_URL "https://chatgpt.com/" ;;
      *) exec python3 "$S/cgc_config.py" set CGC_PROJECT_URL "$url" ;;
    esac ;;
  get-project)
    exec python3 "$S/cgc_config.py" get CGC_PROJECT_URL ;;
  config)
    echo "scripts        $S"
    echo "config file    $(python3 "$S/cgc_config.py" path)"
    echo "CGC_PORT        ${CGC_PORT:-9333}"
    echo "CGC_PROFILE     ${CGC_PROFILE:-$HOME/.cgc-chrome}"
    echo "CGC_STATE_DIR   ${CGC_STATE_DIR:-/tmp/cgc}"
    echo "CGC_SPOOL_DIR   ${CGC_SPOOL_DIR:-${CGC_STATE_DIR:-/tmp/cgc}/spool}"
    echo "daemon         $(python3 "$S/cgc_spool.py" status 2>/dev/null | sed -n '1p' | sed 's/  *spool:.*//' | sed 's/^daemon: //' || echo '?')"
    echo "CGC_AUTO_MODEL  ${CGC_AUTO_MODEL:-1}"
    echo "CGC_MODEL       ${CGC_MODEL:-Pro}"
    echo "CGC_PROJECT_URL ${CGC_PROJECT_URL:-$(python3 "$S/cgc_config.py" get CGC_PROJECT_URL)}"
    echo "CGC_CHROME      ${CGC_CHROME:-<auto-detect>}"
    echo "(stored in config file:)"
    python3 "$S/cgc_config.py" show | sed 's/^/  /' || true
    ;;
  activation-hook)
    # Delegates to cgc_activation.py — the ONE place that owns the hook command string and the
    # settings.json edit logic. Default (no flag) is print-only, matching the old behavior: it
    # never touches your settings unless you pass --install/--remove.
    case "${1:-}" in
      --install) shift; exec python3 "$S/cgc_activation.py" install "$@" ;;
      --remove)  shift; exec python3 "$S/cgc_activation.py" remove "$@" ;;
      --status)  shift; exec python3 "$S/cgc_activation.py" status "$@" ;;
      *)         exec python3 "$S/cgc_activation.py" print "$@" ;;
    esac
    ;;
  ""|-h|--help)
    grep '^#' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) echo "cgc: unknown command '$cmd' (try: cgc --help)" >&2; exit 2 ;;
esac
